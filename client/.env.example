# BlueSPACE LMS client
# The React app talks directly to Supabase. VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY are compiled into the browser bundle — never place a
# service_role or secret key here.

# Local development (supabase start):
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=sb_publishable_your-local-anon-key

# Production:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
