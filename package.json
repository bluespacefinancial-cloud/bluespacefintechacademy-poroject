{
  "name": "bluespace-lms",
  "version": "1.0.0",
  "private": true,
  "description": "BlueSPACE Fintech Academy Learning Management System",
  "scripts": {
    "install:all": "cd client && npm install",
    "dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "lint": "cd client && npm run lint",
    "lint:fix": "cd client && npm run lint:fix",
    "format": "cd client && npm run format",
    "format:check": "cd client && npm run format:check",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v && docker compose up -d",
    "api": "cd backend && ./bin/artisan serve --host=127.0.0.1 --port=8001"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
