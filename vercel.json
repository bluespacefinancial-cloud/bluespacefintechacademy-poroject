{
  "framework": "vite",
  "installCommand": "npm --prefix client install",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "devCommand": "npm --prefix client run dev",
  "regions": ["iad1"],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
